{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ceeducon/hero",
  "version": "1.1.0",
  "title": "Hero sekce",
  "category": "ceeducon-sections",
  "icon": "cover-image",
  "description": "Kompaktní úvodní CEEDUCON sekce s fotografií, CTA a základními údaji o konferenci.",
  "textdomain": "ceeducon-program",
  "attributes": {
    "kicker": { "type": "string", "default": "CEEDUCON 2026 · Prague" },
    "title": { "type": "string", "default": "Central Europe <em>meets the world</em> of higher education." },
    "lead": { "type": "string", "default": "Two days of practical exchange for university leaders, international offices, policymakers and national agencies." },
    "imageUrl": { "type": "string", "default": "/wp-content/themes/ceeducon-program/assets/media/ceeducon-photo-plenary.jpg" },
    "imageId": { "type": "number" },
    "imageAlt": { "type": "string", "default": "A packed CEEDUCON plenary session" },
    "primaryText": { "type": "string", "default": "Explore programme" },
    "primaryUrl": { "type": "string", "default": "/programme/" },
    "secondaryText": { "type": "string", "default": "Plan your visit" },
    "secondaryUrl": { "type": "string", "default": "/practical/" },
    "eventDay": { "type": "string", "default": "1–2" },
    "eventMonth": { "type": "string", "default": "DEC<br>2026" },
    "eventRows": {
      "type": "array",
      "default": [
        { "label": "Venue", "value": "O2 universum Prague" },
        { "label": "Format", "value": "Two conference days onsite" },
        { "label": "Fee", "value": "Free of charge" },
        { "label": "Registration", "value": "Opens in September" }
      ]
    },
    "calendarText": { "type": "string", "default": "Add to calendar" },
    "calendarUrl": { "type": "string", "default": "/wp-content/themes/ceeducon-program/assets/ceeducon-2026.ics" }
  },
  "supports": {
    "html": false,
    "align": false,
    "color": false,
    "spacing": false,
    "typography": false
  },
  "editorScript": "file:./edit.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
