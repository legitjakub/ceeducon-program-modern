{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ceeducon/cta",
  "version": "1.0.0",
  "title": "CTA sekce",
  "category": "ceeducon-sections",
  "icon": "megaphone",
  "description": "Výrazná výzva k akci s editovatelným textem a tlačítky.",
  "textdomain": "ceeducon-program",
  "attributes": {
    "kicker": { "type": "string", "default": "Next step" },
    "title": { "type": "string", "default": "Plan your CEEDUCON visit." },
    "text": { "type": "string", "default": "Use the practical information and programme pages to prepare for the two conference days in Prague." },
    "primaryText": { "type": "string", "default": "Open practical info" },
    "primaryUrl": { "type": "string", "default": "/practical-information/" },
    "secondaryText": { "type": "string", "default": "See programme" },
    "secondaryUrl": { "type": "string", "default": "/programme/" },
    "noteLabel": { "type": "string", "default": "CEEDUCON 2026" },
    "noteTitle": { "type": "string", "default": "1–2 December 2026 · O2 universum Prague" },
    "noteText": { "type": "string", "default": "Registration details will be published once confirmed by the organisers." },
    "dark": { "type": "boolean", "default": true }
  },
  "supports": { "html": false, "align": false, "color": false, "spacing": false, "typography": false },
  "editorScript": "file:./edit.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
