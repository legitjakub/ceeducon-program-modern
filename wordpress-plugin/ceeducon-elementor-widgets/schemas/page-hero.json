{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ceeducon/page-hero",
  "version": "1.0.0",
  "title": "Page hero",
  "category": "ceeducon-sections",
  "icon": "cover-image",
  "description": "Horní hero sekce pro vnitřní stránky.",
  "textdomain": "ceeducon-program",
  "attributes": {
    "crumb": { "type": "string", "default": "About" },
    "title": { "type": "string", "default": "The conference for internationalisation of higher education." },
    "note": { "type": "string", "default": "One forum for strategy, practice and cooperation." },
    "cardLabel": { "type": "string", "default": "CEEDUCON 2026" },
    "cardTitle": { "type": "string", "default": "1–2 December · Prague" },
    "cardText": { "type": "string", "default": "Organised by DZS with national agencies from across Central Europe." }
  },
  "supports": { "html": false, "align": false, "color": false, "spacing": false, "typography": false },
  "editorScript": "file:./edit.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
