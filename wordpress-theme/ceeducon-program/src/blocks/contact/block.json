{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ceeducon/contact",
  "version": "1.0.0",
  "title": "Kontakt",
  "category": "ceeducon-sections",
  "icon": "email",
  "description": "Kontakt na organizátory s kartou partnerů.",
  "textdomain": "ceeducon-program",
  "attributes": {
    "kicker": { "type": "string", "default": "Organiser" },
    "title": { "type": "string", "default": "Czech National Agency for International Education and Research." },
    "text": { "type": "string", "default": "CEEDUCON is organised by DZS in co-operation with Central European partner organisations." },
    "email": { "type": "string", "default": "ceeducon@dzs.cz" },
    "phone": { "type": "string", "default": "+420 221 850 100" },
    "buttonText": { "type": "string", "default": "Email CEEDUCON" },
    "secondaryText": { "type": "string", "default": "DZS website" },
    "secondaryUrl": { "type": "string", "default": "https://www.dzs.cz/" },
    "cardLabel": { "type": "string", "default": "Organised by" },
    "cardTitle": { "type": "string", "default": "Czech National Agency for International Education and Research (DZS)" },
    "partnersLabel": { "type": "string", "default": "In co-operation with" },
    "partnersText": { "type": "string", "default": "OeAD · DAAD · FRSE · SAAIC · Tempus Public Foundation" },
    "logoUrl": { "type": "string", "default": "/wp-content/themes/ceeducon-program/assets/dzs-logo.png" },
    "logoId": { "type": "number" },
    "logoAlt": { "type": "string", "default": "DZS" }
  },
  "supports": { "html": false, "align": false, "color": false, "spacing": false, "typography": false },
  "editorScript": "file:./edit.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
