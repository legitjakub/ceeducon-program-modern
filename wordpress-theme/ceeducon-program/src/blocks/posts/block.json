{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ceeducon/posts",
  "version": "1.0.0",
  "title": "Výpis článků",
  "category": "ceeducon-sections",
  "icon": "welcome-write-blog",
  "description": "Dynamický výpis nejnovějších článků nebo projektů.",
  "textdomain": "ceeducon-program",
  "attributes": {
    "kicker": { "type": "string", "default": "Updates" },
    "title": { "type": "string", "default": "Latest news." },
    "intro": { "type": "string", "default": "Publish updates in WordPress posts and this block will list them automatically." },
    "postType": { "type": "string", "default": "post" },
    "count": { "type": "number", "default": 3 },
    "paper": { "type": "boolean", "default": true }
  },
  "supports": { "html": false, "align": false, "color": false, "spacing": false, "typography": false },
  "editorScript": "file:./edit.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
