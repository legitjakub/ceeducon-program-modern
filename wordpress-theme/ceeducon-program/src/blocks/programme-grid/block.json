{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ceeducon/programme-grid",
  "version": "1.0.0",
  "title": "Programme grid",
  "category": "ceeducon-sections",
  "icon": "calendar-alt",
  "description": "Interaktivní program s vyhledáváním, filtry a fallbackem pro SEO.",
  "textdomain": "ceeducon-program",
  "attributes": {
    "kicker": { "type": "string", "default": "Interactive programme" },
    "title": { "type": "string", "default": "Find the right session faster." },
    "intro": { "type": "string", "default": "Search the programme, compare rooms and times, filter by theme or format and keep your personal selection in one place." }
  },
  "supports": { "html": false, "align": false, "color": false, "spacing": false, "typography": false },
  "editorScript": "file:./edit.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
