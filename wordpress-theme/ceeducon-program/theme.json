{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "palette": [
        {
          "slug": "ceeducon-blue",
          "color": "#0d5e9d",
          "name": "CEEDUCON Blue"
        },
        {
          "slug": "ceeducon-orange",
          "color": "#ec722f",
          "name": "CEEDUCON Orange"
        },
        {
          "slug": "ceeducon-sky",
          "color": "#45c0ea",
          "name": "CEEDUCON Sky"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        }
      ]
    },
    "layout": {
      "contentSize": "1360px",
      "wideSize": "1360px"
    },
    "spacing": {
      "blockGap": false,
      "margin": false,
      "padding": false,
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Tabac Sans\", \"Segoe UI\", Arial, sans-serif",
          "slug": "tabac-sans",
          "name": "Tabac Sans",
          "fontFace": [
            {
              "fontFamily": "Tabac Sans",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Tabac-Sans-Regular.woff2",
                "file:./assets/fonts/Tabac-Sans-Regular.woff"
              ]
            },
            {
              "fontFamily": "Tabac Sans",
              "fontWeight": "500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Tabac-Sans-Medium.woff2",
                "file:./assets/fonts/Tabac-Sans-Medium.woff"
              ]
            },
            {
              "fontFamily": "Tabac Sans",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Tabac-Sans-Bold.woff2",
                "file:./assets/fonts/Tabac-Sans-Bold.woff"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "base",
          "size": "1rem",
          "name": "Base"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "display",
          "size": "clamp(2.5rem, 7vw, 6.25rem)",
          "name": "Display"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#0d5e9d"
    },
    "typography": {
      "fontFamily": "\"Tabac Sans\", \"Segoe UI\", Arial, sans-serif",
      "lineHeight": "1.55"
    }
  }
}
